# Railway inyecta PORT automáticamente
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/JM?retryWrites=true&w=majority
SECURITY_JM=cambia-esto-por-un-secreto-largo
# Duración del token (por defecto 7d, PWA)
TOKEN_TTL=7d
# URL del frontend en Vercel, sin "/" final
# Frontend en red local para probar la PWA desde el celular (pnpm dev --host)
DEV_MOBILE=http://192.168.1.73:5173
CLIENT=https://tu-app.vercel.app
# Mismo par en local y en Railway. La pública tiene 65 bytes y la privada 32.
# pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@tudominio.com
